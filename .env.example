# Copy this file to `.env` and fill in your own keys.
#   cp .env.example .env
# `.env` is gitignored and must never be committed.

# ---- Required ----------------------------------------------------------

# YouTube Data API v3 key — https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" on the project first.
# Used by Stages 1-3. Default free quota is 10,000 units/day.
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Google Gemini API key — https://aistudio.google.com/app/apikey
# Used by Stage 4 for message generation.
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Strongly recommended --------------------------------------------------

# Mistral API key — https://console.mistral.ai (free "Experiment" plan).
# Gemini's free tier allows only 20 generateContent requests per DAY per MODEL,
# which is below what a 69-creator run needs. Stage 4 rotates through several
# Gemini models first and falls back to Mistral once they are spent, so this key
# is what makes a full run survivable on free tiers. Without it the pipeline
# still works, but may stop partway with HTTP 429.
MISTRAL_API_KEY=your_mistral_api_key_here

# ---- Optional overrides ----------------------------------------------------

# Comma-separated Gemini models to rotate through, in order. Each has its own
# 20/day free-tier cap, so more models = more daily headroom at zero cost.
# GEMINI_MODEL=gemini-3.5-flash,gemini-3.6-flash,gemini-flash-lite-latest

# Comma-separated Mistral models used as the fallback.
# MISTRAL_MODEL=mistral-small-latest

# ---- Optional: only needed for `--stage send --mode live` --------------
# Without these, Stage 5 runs in simulate mode and sends nothing.
# For Gmail use an App Password (https://myaccount.google.com/apppasswords),
# not your account password.

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDER_NAME=EDXSO Partnerships Team
SENDER_EMAIL=partnerships@edxso.com
